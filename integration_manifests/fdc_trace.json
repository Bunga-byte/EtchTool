  "validation_rule_ids": [
    "utc_aware_effective_and_recorded_time",
    "preserve_original_content_hash_revision",
    "exact_evidence_location_required",
    "scope_source_equipment_collection",
    "missing_serial_or_install_time_review",
    "no_latest_arrival_authority",
    "no_automatic_failure_from_alarm_or_replacement"
  ],
  "identity_matching": {
    "deterministic_key_sets": [
      [
        "tool_alias",
        "chamber_alias",
        "channel_id",
        "configuration_id",
        "effective_at"
      ]
    ],
    "description_only_merge_permitted": false,
    "effective_interval_required": true,
    "approved_aliases_required": true,
    "missing_identity_action": "review_no_promotion",
    "ambiguity_action": "review_no_merge",
    "internal_ai_may_propose": true,
    "internal_ai_may_verify_or_promote": false
  },
  "review_policy": {
    "default": "engineering_approval_required",
    "automatic_promotion_enabled": false,
    "source_authority_rules": [],
    "hard_stop_conditions": [
      "missing_source_permission",
      "unknown_equipment_or_collection",
      "unsupported_capability",
      "missing_identity_or_effective_timestamp",
      "ambiguous_serial_or_position",
      "conflicting_source_assertions",
      "unverified_sensor_mapping",
      "undocumented_oem_limit",
      "external_ai_for_confidential_data"
    ]
  },
  "synchronization": {
    "frip_workflow_modes": [
      "backfill",
      "incremental",
      "reprocess"
    ],
    "actual_source_method": null,
    "incremental_source_field": null,
    "checkpoint_semantics": "Persist only the last committed page. Unchanged hints use metadata_version_token(DocumentMetadata) over the complete UTC-normalized envelope, never body hash/revision alone; metadata-only corrections must be retrieved/reconciled. Resume without skipping failed work; actual source cursor semantics require approval.",
    "periodic_polling_authorized": false,
    "max_page_size": 100,
    "bounded_queries_required": true,
    "retry": {
      "max_attempts": 3,
      "initial_backoff_seconds": 1,
      "max_backoff_seconds": 60,
      "authorization_failure_action": "stop_no_retry"
    },
    "dead_letter_on_exhaustion": true
  },
  "error_handling": {
    "unchanged_content": "deduplicate_preserve_lineage",
    "invalid_record": "quarantine_with_evidence",
    "conflicting_source": "preserve_both_review_required",
    "unsupported_capability": "explicit_error_no_fallback_scraping",
    "unavailable_evidence": "unverified_no_promotion"
  },
