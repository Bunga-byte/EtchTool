# Local synthetic demonstration only. Do not reuse this password in a deployment.
FRIP_DB_PASSWORD=frip-local-synthetic
FRIP_MODE=synthetic
# Local Python defaults to sqlite:///./frip.db when unset.
# FRIP_DATABASE_URL=postgresql+psycopg://frip:YOUR_PASSWORD@localhost:5432/frip
# No mutation credentials are enabled by default.
# Set FRIP_TOKENS_JSON through your shell or approved secret manager; never commit it.
# FRIP_TOKENS_JSON maps token values to {"role":"editor","subject":"engineer"}.
